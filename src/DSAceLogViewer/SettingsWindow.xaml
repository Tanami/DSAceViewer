<Window x:Class="DSAceLogViewer.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#191919" Foreground="#E8E8E8" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Log file" Margin="0,0,0,8" />
      <TextBox x:Name="PathBox" IsReadOnly="True" FontSize="12" AutomationProperties.Name="Log file location" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,16">
      <Button Content="Choose file…" Click="Choose_Click" Margin="0,0,8,0" />
      <Button Content="Use default" Click="Default_Click" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal">
      <TextBlock Text="Encoding" VerticalAlignment="Center" Margin="0,0,16,0" />
      <ComboBox x:Name="EncodingBox" Width="175" AutomationProperties.Name="Text encoding"><ComboBoxItem Content="Auto" /><ComboBoxItem Content="UTF-8" /><ComboBoxItem Content="Windows-1252" /></ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
      <CheckBox x:Name="LineNumbersBox" Content="Show line numbers" Margin="0,0,24,0" />
      <CheckBox x:Name="EntryTypeBox" Content="Show entry type" Margin="0,0,24,0" />
      <CheckBox x:Name="WordWrapBox" Content="Word wrap" />
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Save" Click="Save_Click" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
